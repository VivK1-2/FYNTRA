# Local development. Copy to .env:   cp .env.example .env
# Never commit .env. Never paste real keys into chat, screenshots or the frontend.
# The backend reads .env only when it starts: restart it after every edit.

ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fyntra

# Must equal FYNTRA_API_KEY in frontend/.env  (use the word "disabled" to switch the check off locally)
API_KEY=localdevkey123
# Key for the Admin page (at least 16 characters). Leave empty to switch the Admin page off.
ADMIN_KEY=localadminkey1234567890
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Original filings are saved here. A relative path is placed inside the backend folder.
STORAGE_DIR=./storage

# The SEC blocks anonymous clients: use a real contact email.
SEC_USER_AGENT=FYNTRA Research (you@yourdomain.com)

# ---- Language model (configured ONLY here; the web app never sees these) ----
LLM_BASE_URL=https://api.scalemax.pro/token/v1
LLM_API_KEY=paste_your_key_here
# Any chat model your provider plan includes. Check with:  python scripts/check_llm.py
LLM_MODEL=gpt-6-luna
# Optional second model, tried only if the first one fails
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=90

# Rate limits per client IP per minute (0 = off). The second applies to /ask and /ingest.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_LLM_PER_MINUTE=12
