# Production (VPS). Copy to .env on the server:  cp deploy/.env.production.example .env && chmod 600 .env
# NEVER commit .env. Never paste real keys into chat, screenshots or the frontend.

ENVIRONMENT=production
API_DOMAIN=api.yourdomain.com

# Generate: openssl rand -hex 32
API_KEY=replace_with_long_random_value
# Separate key for the Admin page. Leave empty to disable it. Generate one with: openssl rand -hex 24
ADMIN_KEY=
POSTGRES_PASSWORD=replace_with_long_random_value

# Frontend origin(s), comma separated. No wildcard in production.
CORS_ORIGINS=https://app.yourdomain.com

# SEC requires a real contact email in the User-Agent
SEC_USER_AGENT=FYNTRA Research (you@yourdomain.com)

# ---- Language model (configured ONLY here; the web app never sees these) ----
LLM_BASE_URL=https://api.scalemax.pro/token/v1
LLM_API_KEY=replace_with_your_key
LLM_MODEL=gpt-6-luna
LLM_FALLBACK_MODEL=

# Rate limits per client IP per minute (0 = off). The second applies to /ask and /ingest.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_LLM_PER_MINUTE=12
